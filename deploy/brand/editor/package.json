{
  "name": "lrm-vault-editor",
  "private": true,
  "description": "The Vault's live-preview editor (CodeMirror 6), bundled into ../vendor/lrm-editor.js. Rebuild: npm ci && npm run build",
  "scripts": {
    "build": "esbuild src/editor.js --bundle --minify --format=iife --global-name=LrmEditor --target=es2020 --outfile=../vendor/lrm-editor.js"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.18.6",
    "@codemirror/commands": "6.8.1",
    "@codemirror/lang-markdown": "6.3.2",
    "@codemirror/language": "6.11.0",
    "@codemirror/search": "6.5.10",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.36.8",
    "@lezer/markdown": "1.4.3",
    "esbuild": "0.25.4",
    "@lezer/highlight": "1.2.1"
  }
}
